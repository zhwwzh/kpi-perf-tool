<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Spring Boot 默认配置：CONSOLE_LOG_PATTERN / FILE_LOG_PATTERN / 颜色等 -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml" />
    <include resource="org/springframework/boot/logging/logback/console-appender.xml" />

    <!-- 日志根路径：默认 ${user.dir}/logs，可通过 -DLOG_PATH=... 覆盖 -->
    <property name="LOG_PATH" value="${LOG_PATH:-${user.dir}/logs}" />
    <property name="LOG_FILE_NAME" value="console" />

    <!-- 文件 appender：UTF-8、按日 + 大小滚动、保留 7 天 / 100MB -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${LOG_FILE_NAME}.log</file>
        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/${LOG_FILE_NAME}.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- 框架噪声降级（H）：保持业务日志聚焦 -->
    <logger name="org.springframework" level="WARN" />
    <logger name="org.apache" level="WARN" />
    <logger name="com.zaxxer.hikari" level="WARN" />
    <logger name="com.mysql" level="WARN" />
    <logger name="com.alibaba.excel" level="WARN" />

    <!-- 业务包默认 INFO，可通过 -DPERF_LOG_LEVEL=DEBUG 切到 DEBUG（看进度等） -->
    <logger name="com.shenghui56.dev.kpiperftool" level="${PERF_LOG_LEVEL:-INFO}" />

    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </root>
</configuration>